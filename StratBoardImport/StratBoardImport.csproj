<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.6.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Author>Dr0nhp</Author>
    <Name>Strategy Board Plus</Name>
    <InternalName>StratBoardImport</InternalName>
    <Punchline>Import, store, and manage Strategy Boards beyond the 50-slot Saved List.</Punchline>
    <Description>Writes Strategy Board share codes into the Saved List, even when they are too long for the vanilla field. Paste one code or several [stgy:] pages into folders. Keep extra boards in a plugin library, send them back to the game, and export JSON for websites. Also clears saved boards (the game has no bulk delete). Command: /sbi</Description>
    <RepoUrl>https://github.com/Dr0nhp/StratBoardImport</RepoUrl>
    <Tags>strategy;board;import;stgy;raid</Tags>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\Translations\*.json" />
    <Content Include="Localization\Translations\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
